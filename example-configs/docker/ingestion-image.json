{
  "schema": "example",
  "context": {
    "contentFactory": "InMemoryContentFactory",
    "resolvers": [
      "disk"
    ]
  },
  "operators": {
    "enumerator": {
      "factory": "FileSystemEnumerator",
      "parameters": {
        "path": "C:/vitrivr/vitrivr-engine/example/demo-images",
        "depth": "3",
        "mediaTypes": "IMAGE",
        "limit": "1",
        "regex": ".*architecture_02[.]jpg$"
      }
    },
    "decoder": {
      "factory": "ImageDecoder"
    },
    "aggregator": {
      "factory": "MiddleContentAggregator"
    },
    "persister": {
      "factory": "PersistRetrievableTransformer"
    },
    "thumbnail": {
      "exporter": "thumbnail"
    },
    "averagecolor": {
      "field": "averagecolor"
    },
    "source": {
      "field": "file"
    },
    "tags": {
      "field": "tags",
      "parameters": {
        "caption_host": "http://localhost:5003",
        "caption_model": "vit_gpt2",
        "candidate_limit": "12",
        "top_k": "5",
        "threshold": "0.0",
        "timeoutMs": "300000",
        "pollingIntervalMs": "1000",
        "retries": "1",
        "caption_prompts": "<empty>",
        "caption_fallback_host": "http://localhost:5001"
      }
    }
  },
  "operations": {
    "enumerator": {
      "operator": "enumerator"
    },
    "decoder": {
      "operator": "decoder",
      "inputs": [
        "enumerator"
      ]
    },
    "middle": {
      "operator": "aggregator",
      "inputs": [
        "decoder"
      ]
    },
    "persist": {
      "operator": "persister",
      "inputs": [
        "middle"
      ]
    },
    "thumbnail": {
      "operator": "thumbnail",
      "inputs": [
        "persist"
      ]
    },
    "averagecolor": {
      "operator": "averagecolor",
      "inputs": [
        "thumbnail"
      ]
    },
    "source": {
      "operator": "source",
      "inputs": [
        "averagecolor"
      ]
    },
    "tags": {
      "operator": "tags",
      "inputs": [
        "source"
      ]
    }
  },
  "output": [
    "tags"
  ],
  "mergeType": "MERGE"
}
